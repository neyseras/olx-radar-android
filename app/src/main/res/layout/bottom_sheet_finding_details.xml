<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Top Drag Handle & Telemetry Header Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_modal_handle" />

            <ImageButton
                android:id="@+id/btn_sheet_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_icon_button_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/action_stop"
                android:src="@drawable/ic_clear"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <!-- Telemetry Top Bar (ID + Active Status) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="OLX RADAR AI INSPECTOR"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Активно"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Product Photo Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sheet_photo"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_sheet_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_finding_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_radar" />

                <!-- Photo counter overlay badge at bottom-right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_telemetry_box"
                    android:backgroundTint="@color/surface_overlay_90"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_dot_active" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="monospace"
                        android:text="1/4"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pricing & Spread Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sheet_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="2 900 ₴" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Spread pill badge -->
            <TextView
                android:id="@+id/tv_sheet_reason_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/secondary_alpha_15"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Выгодная цена"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_ai_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="96% Подходит"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Product Title -->
        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Sapphire Radeon RX 580 8GB Nitro+ Special Edition" />

        <!-- Location & Time Metadata Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tv_sheet_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="Киев, Печерский" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/outline" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_schedule"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_sheet_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="8 минут назад" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/outline" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                app:tint="@color/tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Частное лицо"
                android:textColor="@color/tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick feature pills row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shipping"
                    app:tint="@color/secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="OLX Доставка включена"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_verified_user"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Безопасная сделка"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/card_stroke" />

        <!-- Groq Vision AI Analysis Hero Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layout_ai_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header of Groq Vision Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tag_chip"
                        android:backgroundTint="@color/primary_alpha_15">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_smart_toy"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Результат проверки Groq Vision"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Анализ фото и соответствия"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/secondary_alpha_15"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="✓ Проверено"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Match Score Tile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_telemetry_box"
                    android:backgroundTint="@color/surface_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_sheet_ai_score"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button_circle"
                        android:backgroundTint="@color/secondary_alpha_15"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:textColor="@color/secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="96%" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:text="ВЫСОКАЯ ТОЧНОСТЬ"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Все ключевые компоненты распознаны"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Checklist Verification Items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_sheet_ai_photo_match"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="✓ Фото полностью соответствует названию" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        tools:text="✓ Оригинальный товар: Sapphire Nitro+ RX 580" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="✓ Модель: Special Edition 8GB" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_condition_completeness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="✓ Состояние: Отличное • Заводская пломба сохранена" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_defects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/danger"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="⚠ Обнаружены дефекты"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_reject_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:padding="10dp"
                        android:textColor="@color/danger"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="✗ Причина отклонения"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_sheet_ai_reasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_telemetry_box"
                        android:backgroundTint="@color/surface_container"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="• Система охлаждения Nitro+\n• Заводская гарантийная пломба на месте\n• Следов перегрева и майнинга нет" />
                </LinearLayout>

                <!-- Raw JSON toggle -->
                <TextView
                    android:id="@+id/btn_toggle_raw_json"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="@string/ai_raw_json_label"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sheet_raw_json"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_telemetry_box"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Description Section (Seller's Note) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_description"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Описание продавца"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Оригинал"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sheet_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    tools:text="Продам свою відеокарту Sapphire Nitro+ RX 580 8Gb Special Edition. Купувалась для домашнього ПК..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sticky Bottom Action Bar with Tactical Elevation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_sheet_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/sheet_action_share"
                android:src="@drawable/ic_share"
                app:tint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sheet_open_olx"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_open_olx"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_open"
                app:iconGravity="textEnd"
                app:iconSize="18dp"
                app:iconTint="@color/on_primary" />

            <ImageButton
                android:id="@+id/btn_sheet_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/action_delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/danger" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>