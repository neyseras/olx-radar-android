<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_watch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_container"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon + Query Details + Active Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tag_chip"
                    android:backgroundTint="@color/surface_container_highest">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_radar"
                        app:tint="@color/primary" />
                </FrameLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_status_dot_active" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_watch_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Sapphire RX 580 8GB" />

                <TextView
                    android:id="@+id/tv_watch_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="Запрос: RX 580 + Sapphire" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_watch_active"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_toggle_watch" />
        </LinearLayout>

        <!-- Dynamic Constraint & Telemetry Badges Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Findings badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_telemetry_box"
                android:backgroundTint="@color/secondary_alpha_15"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/secondary" />

                <TextView
                    android:id="@+id/tv_watch_findings_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="+4 сегодня" />
            </LinearLayout>

            <!-- Stopwords badge -->
            <TextView
                android:id="@+id/tv_watch_stopwords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_telemetry_box"
                android:backgroundTint="@color/surface_container_highest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Стоп-слова"
                tools:visibility="visible" />

            <!-- Mustwords badge -->
            <TextView
                android:id="@+id/tv_watch_mustwords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_telemetry_box"
                android:backgroundTint="@color/surface_container_highest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Обязательные"
                tools:visibility="visible" />

            <!-- Snooze badge -->
            <TextView
                android:id="@+id/tv_watch_snooze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_telemetry_box"
                android:backgroundTint="@color/surface_container_highest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/tertiary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Снуз"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_stroke" />

        <!-- Bottom Telemetry Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot_active" />

            <TextView
                android:id="@+id/tv_watch_last_success"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Каждые 20 сек" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Активен"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Action buttons inside card tray -->
            <ImageButton
                android:id="@+id/btn_duplicate_watch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/cd_duplicate_watch"
                android:src="@drawable/ic_list"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_delete_watch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button_circle"
                android:backgroundTint="@color/surface_container_high"
                android:contentDescription="@string/cd_delete_watch"
                android:src="@drawable/ic_delete"
                app:tint="@color/danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_watch_last_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Ошибка опроса: HTTP 429"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>